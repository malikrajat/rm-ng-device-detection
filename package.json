{
  "name": "rm-ng-device-detection",
  "version": "5.0.0",
  "license": "MIT",
  "description": "Angular device detection library for browser, OS, platform, mobile, tablet, desktop, and user-agent detection with SSR-safe runtime checks.",
  "keywords": [
    "angular",
    "angular-20",
    "angular-26",
    "angular-library",
    "angular-service",
    "angular-device-detection",
    "device-detection",
    "device detection",
    "device-detector",
    "device detector",
    "browser-detection",
    "browser-detect",
    "user-agent",
    "user agent",
    "user-agent-parser",
    "ua-parser",
    "platform-detection",
    "platform-detect",
    "os-detection",
    "mobile-detection",
    "mobile-detect",
    "tablet-detection",
    "desktop-detection",
    "device-type",
    "orientation-detection",
    "runtime-detection",
    "environment-detection",
    "responsive-design",
    "responsive-ui",
    "ssr",
    "angular-ssr",
    "angular-universal",
    "server-side-rendering",
    "ssr-safe",
    "pwa",
    "micro-frontend",
    "typescript",
    "web-utils",
    "utility-library",
    "ng-device-detection",
    "rm-ng-device-detection"
  ],
  "author": {
    "name": "Rajat Malik",
    "email": "mr.rajatmalik@gmail.com",
    "url": "https://www.rajatmalik.dev/"
  },
  "contributors": [
    {
      "name": "Rajat Malik",
      "email": "mr.rajatmalik@gmail.com"
    }
  ],
  "maintainers": [
    {
      "name": "Rajat Malik",
      "email": "mr.rajatmalik@gmail.com"
    }
  ],
  "homepage": "https://github.com/malikrajat/rm-ng-device-detection#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malikrajat/rm-ng-device-detection.git"
  },
  "bugs": {
    "url": "https://github.com/malikrajat/rm-ng-device-detection/issues",
    "email": "mr.rajatmalik@gmail.com"
  },
  "peerDependencies": {
    "@angular/common": ">=16.0.0 <=26.0.0",
    "@angular/core": ">=16.0.0 <=26.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/malikrajat"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "packageGroup": [
      "rm-ng-device-detection"
    ]
  },
  "directories": {
    "lib": "./src",
    "doc": "./docs"
  },
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "private": false,
  "readme": "README.md",
  "module": "fesm2022/rm-ng-device-detection.mjs",
  "typings": "types/rm-ng-device-detection.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/rm-ng-device-detection.d.ts",
      "default": "./fesm2022/rm-ng-device-detection.mjs"
    }
  }
}